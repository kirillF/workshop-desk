# Optional shell environment. No .env file is required.
# Export values before running npm commands; Node does not auto-load this file.
WORKSHOP_DB_PATH=data/workshop.sqlite
API_HOST=127.0.0.1
API_PORT=4000
WEB_HOST=127.0.0.1
WEB_PORT=5173
# Optional browser API override; used by Vite during dev/build.
VITE_API_URL=http://127.0.0.1:4000

# Exact frontend origin accepted for credentialed browser requests.
WEB_ORIGIN=http://127.0.0.1:5173
