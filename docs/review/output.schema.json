{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Compact structured code review report",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "requirementsQuestions", "limitations"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "title", "location", "body", "followUps"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "startLine", "endLine", "revision"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              },
              "revision": {
                "type": "string",
                "enum": ["base", "head"]
              }
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "followUps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "proposal", "acceptanceCondition"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "code_fix",
                    "regression_test",
                    "deterministic_check",
                    "requirements_decision",
                    "documentation"
                  ]
                },
                "proposal": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "acceptanceCondition": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        }
      }
    },
    "requirementsQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "decisionNeeded"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "decisionNeeded": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
